# From the stock/Lineage recovery ramdisk. TWRP's own init.recovery.usb.rc reads sys.usb.controller.

# The SELinux policy loaded in recovery doesn't cover TWRP: every mkdir in /, property set and
# sysfs write is denied, and TWRP aborts reading /etc/additional.fstab in a restart loop with a
# blank screen (confirmed on hardware: `setenforce 0` makes TWRP come up). Go permissive before
# TWRP starts. This file is only in the recovery ramdisk, so normal Android boot is unaffected.
on early-init
    write /sys/fs/selinux/enforce 0

on init
    write /sys/fs/selinux/enforce 0
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 0

on fs && property:ro.debuggable=0
    # distinguish USB shoulde connect or not, i.e. CDP vs SDP
    write /sys/class/udc/musb-hdrc/device/cmode 2
    # set charging free due to it wait for USB activation
    start adbd

