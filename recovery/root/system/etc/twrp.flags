# TWRP display/backup flags. Mount points here are TWRP-only and not used by Android.
#<mnt_point>      <type>  <src>                                <flags>
/boot             emmc    /dev/block/by-name/boot              flags=display="Boot";slotselect;backup=1;flashimg=1
/vendor_boot      emmc    /dev/block/by-name/vendor_boot       flags=display="Vendor Boot (TWRP lives here)";slotselect;backup=1;flashimg=1
/dtbo             emmc    /dev/block/by-name/dtbo              flags=display="DTBO";slotselect;backup=1;flashimg=1
/vbmeta           emmc    /dev/block/by-name/vbmeta            flags=display="VBMeta";slotselect;backup=1;flashimg=1
/vbmeta_system    emmc    /dev/block/by-name/vbmeta_system     flags=display="VBMeta System";slotselect;backup=1;flashimg=1
/vbmeta_vendor    emmc    /dev/block/by-name/vbmeta_vendor     flags=display="VBMeta Vendor";slotselect;backup=1;flashimg=1

# Logical partitions inside super (names checked on device), so Install Image can target each
# one instead of all of Super. Mount points end in _image so they don't clash with recovery.fstab.
# TWRP can't resize logical partitions: an image bigger than the current partition won't fit
# (use fastbootd for that: `adb reboot fastboot`, `fastboot flash system system.img`).
/system_image     emmc    /dev/block/mapper/system             flags=display="System Image";slotselect;flashimg=1
/system_ext_image emmc    /dev/block/mapper/system_ext         flags=display="System_ext Image";slotselect;flashimg=1
/product_image    emmc    /dev/block/mapper/product            flags=display="Product Image";slotselect;flashimg=1
/vendor_image     emmc    /dev/block/mapper/vendor             flags=display="Vendor Image";slotselect;flashimg=1
/vendor_dlkm_image emmc    /dev/block/mapper/vendor_dlkm        flags=display="Vendor_dlkm Image";slotselect;flashimg=1
/odm_dlkm_image   emmc    /dev/block/mapper/odm_dlkm           flags=display="Odm_dlkm Image";slotselect;flashimg=1
/system_dlkm_image emmc    /dev/block/mapper/system_dlkm        flags=display="System_dlkm Image";slotselect;flashimg=1

# Device-unique calibration / IMEI data — back these up before anything risky.
/nvram            emmc    /dev/block/by-name/nvram             flags=display="NVRAM";backup=1;flashimg=1
/nvdata           ext4    /dev/block/by-name/nvdata            flags=display="NVDATA";backup=1
/nvcfg            ext4    /dev/block/by-name/nvcfg             flags=display="NVCFG";backup=1
/protect_f        ext4    /dev/block/by-name/protect1          flags=display="Protect_f";backup=1
/protect_s        ext4    /dev/block/by-name/protect2          flags=display="Protect_s";backup=1
/persist          ext4    /dev/block/by-name/persist           flags=display="Persist";backup=1
/proinfo          emmc    /dev/block/by-name/proinfo           flags=display="Proinfo";backup=1;flashimg=1

# Internal storage is UFS (sdX), so the microSD slot is mmcblk0, not mmcblk1 (checked on device).
# The type is only used for wiping; TWRP detects the real filesystem (FAT32/exFAT) when mounting.
/external_sd      vfat    /dev/block/mmcblk0p1 /dev/block/mmcblk0   flags=display="MicroSD";storage;wipeingui;removable
# USB OTG: internal UFS uses sda, sdb and sdc, so a USB drive appears as sdd (checked on device).
# No "wipeingui": if the UFS layout ever changed, a wipe from TWRP could hit an internal disk.
/usb_otg          vfat    /dev/block/sdd1 /dev/block/sdd            flags=display="USB OTG";storage;removable
